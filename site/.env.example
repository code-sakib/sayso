# Copy to .env.local and fill in. .env.local is git-ignored: never commit real keys.

# Meta Model API key. Every model SaySo calls at runtime is a Meta model
# (Muse Voice Transcribe, SAM 3.1, Muse Spark), all through this one key.
MODEL_API_KEY=

# Shared secret the badge sends when it uploads a recording. Any long random string;
# put the same value in firmware/badge/secrets.h as BADGE_TOKEN.
SAYSO_BADGE_TOKEN=

# Optional: where recordings, entries and reports are stored. Defaults to ./data.
# SAYSO_DATA_DIR=./data
